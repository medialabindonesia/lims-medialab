# Template blok server LIMS Medialab.
#
# Satu file per environment. Ganti tiga nilai berikut, lalu simpan sebagai
# /etc/nginx/sites-available/<APP_NAME>:
#
#   environment  server_name                        proxy_pass  app root
#   -----------  --------------------------------   ----------  -----------------------------------
#   production   lims.medialab.co.id                3001        /opt/apps/lims-medialab
#   development  dev.lims.medialab.co.id            3002        /opt/apps/lims-medialab-development
#   marketing    marketing.lims.medialab.co.id      3003        /opt/apps/lims-medialab-marketing
#   coa          coa.lims.medialab.co.id            3004        /opt/apps/lims-medialab-coa

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    client_max_body_size 260M;

    # Lampiran support persisten dan dilayani langsung oleh Nginx.
    # Path ini WAJIB mengikuti app root environment yang bersangkutan —
    # kalau salah, environment dev akan menyajikan lampiran milik produksi.
    location /uploads/ {
        alias /opt/apps/lims-medialab/shared/uploads/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Upload di-stream ke Next.js tanpa dibuffer ke disk sementara Nginx.
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# Environment non-produksi sebaiknya tidak terindeks mesin pencari.
# Tambahkan di dalam blok server dev/marketing/coa:
#
#     add_header X-Robots-Tag "noindex, nofollow" always;
#
#     location = /robots.txt {
#         add_header Content-Type text/plain;
#         return 200 "User-agent: *\nDisallow: /\n";
#     }
