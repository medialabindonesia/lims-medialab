# Salin menjadi /opt/apps/lims-medialab/shared/.env di VPS.
# Gunakan password yang sudah di-URL-encode jika mengandung karakter khusus.
DATABASE_URL="mysql://lims_user:GANTI_PASSWORD@127.0.0.1:3306/lims_medialab"

# Buat dengan: openssl rand -base64 48
JWT_SECRET="GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER"

# Opsional: fitur realtime support akan no-op jika kosong.
ABLY_API_KEY=""

# Jangan tampilkan akun demo di halaman login produksi.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"

# Penanda environment. Dikosongkan di produksi; diisi "development",
# "marketing", atau "coa" di environment lain agar pita peringatan muncul di
# atas dashboard. Lihat docs/ENVIRONMENTS.md.
APP_ENV=""
NEXT_PUBLIC_APP_ENV=""

# Pengiriman quotation melalui Resend. Biarkan kosong bila environment ini
# hanya dipakai menyusun/review draft dan belum boleh mengirim email nyata.
# Domain pada MAIL_FROM harus sudah diverifikasi di dashboard Resend.
RESEND_API_KEY=""
MAIL_FROM=""
# Opsional; alamat balasan customer (mis. tim sales/CS), bila berbeda dari FROM.
MAIL_REPLY_TO=""

# Identitas resmi pada PDF quotation. Isi dari data legal Medialab yang sudah
# disetujui; jangan menyalin data PT CONTOH dari berkas referensi.
QUOTATION_COMPANY_NAME=""
QUOTATION_COMPANY_ADDRESS=""
QUOTATION_COMPANY_PHONE=""
QUOTATION_COMPANY_FAX=""
QUOTATION_COMPANY_EMAIL=""
QUOTATION_COMPANY_WEBSITE=""
QUOTATION_BANK_NAME=""
QUOTATION_BANK_ACCOUNT_NAME=""
QUOTATION_BANK_ACCOUNT_NUMBER=""
QUOTATION_FORM_CODE="MI-FR-MKT-8.2-01.01"
QUOTATION_FORM_REVISION="Rev.07"
QUOTATION_FORM_EFFECTIVE_DATE="23 September 2024"
# Angka rupiah tanpa pemisah ribuan; kosong berarti syarat minimum tidak dicetak.
QUOTATION_MINIMUM_ORDER=""

# Lampiran harus berada di luar direktori release agar persisten.
SUPPORT_UPLOAD_DIR="/opt/apps/lims-medialab/shared/uploads"
# Fallback opsional saat migrasi dari instalasi lama (harus writable oleh user PM2).
SUPPORT_UPLOAD_FALLBACK_DIR="/opt/apps/lims-medialab/shared/uploads-fallback"

# Khusus development saat membuat migrasi; tidak diperlukan di VPS produksi.
# SHADOW_DATABASE_URL="mysql://lims_user:GANTI_PASSWORD@127.0.0.1:3306/lims_medialab_shadow"
