generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum QuotationStatus {
  REQUESTED
  VERIFIED
  REVISION
  NEGOTIATION
  APPROVED
  CONFIRMED
  PO_UPLOADED
  LTR_CREATED
  COC_CREATED
}

enum SampleStatus {
  WAITING_SAMPLE
  SAMPLE_SENT
  RECEIVED
  DISTRIBUTED
  IN_ANALYSIS
  REVIEWED
  VERIFIED
  VALIDATED
  PRELIMINARY_COA
  FINAL_COA
  COMPLETED
  RETEST
}

enum ResultStatus {
  WAITING
  IN_PROGRESS
  ENTERED
  REVIEWED
  VERIFIED
  VALIDATED
  RETEST
}

enum CoaType {
  PRELIMINARY
  FINAL
}

enum CoaStatus {
  DRAFT
  SENT_TO_CUSTOMER
  CUSTOMER_CONFIRMED
  APPROVED
}

enum InvoiceStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  SENT
  PAYMENT_SUBMITTED
  PAID
}

enum SamplingBy {
  MEDIALAB
  CUSTOMER
  THIRD_PARTY
}

enum TatRequest {
  NORMAL
  URGENT
  TOP_URGENT
}

enum TestingObjective {
  ROUTINE_MONITORING
  SUPERVISION
  CASE_PROOF
  RESEARCH
  OTHER
}

enum DeliveryMethod {
  MEDIALAB_SAMPLING
  CUSTOMER_DELIVERY
  COURIER
  OTHER
}

enum StpsStatus {
  DRAFT
  ISSUED
}

model Role {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  users     User[]
  roleMenus RoleMenu[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  password   String
  roleId     String
  customerId String?
  isActive   Boolean   @default(true)

  role       Role      @relation(fields: [roleId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Menu {
  id        String     @id @default(cuid())
  name      String
  key       String     @unique
  href      String
  icon      String?
  parentId  String?
  sort      Int        @default(0)
  isActive  Boolean    @default(true)

  parent    Menu?      @relation("MenuChildren", fields: [parentId], references: [id])
  children  Menu[]     @relation("MenuChildren")
  roleMenus RoleMenu[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model RoleMenu {
  id          String  @id @default(cuid())
  roleId      String
  menuId      String

  canView     Boolean @default(false)
  canCreate   Boolean @default(false)
  canUpdate   Boolean @default(false)
  canDelete   Boolean @default(false)
  canApprove  Boolean @default(false)
  canValidate Boolean @default(false)
  canExport   Boolean @default(false)

  role        Role    @relation(fields: [roleId], references: [id])
  menu        Menu    @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
}

model Customer {
  id         String      @id @default(cuid())
  name       String
  company    String?
  email      String?
  phone      String?
  isActive   Boolean     @default(true)

  contactPerson String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  province      String?
  npwp          String?
  npwpAddress   String?

  billingCompany       String?
  billingAddressLine1  String?
  billingAddressLine2  String?
  billingContactPerson String?
  billingEmail         String?
  billingPhone         String?

  samplingCompany       String?
  samplingAddressLine1  String?
  samplingAddressLine2  String?
  samplingContactPerson String?
  samplingPhone         String?

  documentCompany       String?
  documentAddressLine1  String?
  documentAddressLine2  String?
  documentContactPerson String?
  documentPhone         String?

  recipientEmail1 String?
  recipientEmail2 String?
  recipientEmail3 String?
  recipientEmail4 String?

  users      User[]
  quotations Quotation[]
  samples    Sample[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model AnalysisParameter {
  id          String                 @id @default(cuid())
  name        String
  unit        String?
  method      String?
  price       Float                  @default(0)
  isActive    Boolean                @default(true)

  quotationItems     QuotationItem[]
  sampleParams       SampleParameter[]
  templateParameters CoaTemplateParameter[]

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model CoaTemplate {
  id          String                 @id @default(cuid())
  name        String
  code        String                 @unique
  description String?
  isActive    Boolean                @default(true)

  parameters  CoaTemplateParameter[]
  quotations  Quotation[]
  samples     Sample[]

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model CoaTemplateParameter {
  id          String            @id @default(cuid())
  templateId  String
  parameterId String

  displayName String?
  unit        String?
  method      String?
  standard    String?
  limitValue  String?
  sort        Int               @default(0)
  isRequired  Boolean           @default(true)
  isActive    Boolean           @default(true)

  template    CoaTemplate       @relation(fields: [templateId], references: [id])
  parameter   AnalysisParameter @relation(fields: [parameterId], references: [id])
  sampleParams SampleParameter[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([templateId, parameterId])
}

model Quotation {
  id            String           @id @default(cuid())
  quotationNo   String           @unique
  customerId    String
  coaTemplateId String?
  status        QuotationStatus  @default(REQUESTED)
  totalAmount   Float            @default(0)
  note          String?

  quotationDate DateTime         @default(now())
  validUntil    DateTime?

  samplingBy       SamplingBy?
  testingObjective TestingObjective?
  tatRequested     TatRequest?

  samplingCost Float @default(0)
  vatPercent   Float @default(11)
  vatAmount    Float @default(0)
  grandTotal   Float @default(0)

  paymentTerm String?
  termsNote   String?

  requestedById String?
  verifiedById  String?
  approvedById  String?

  customer      Customer         @relation(fields: [customerId], references: [id])
  coaTemplate   CoaTemplate?     @relation(fields: [coaTemplateId], references: [id])
  items         QuotationItem[]
  purchaseOrder PurchaseOrder?
  ltr           Ltr?
  coc           Coc?
  invoice       Invoice?
  samples       Sample[]
  stps          Stps[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model QuotationItem {
  id          String            @id @default(cuid())
  quotationId String
  parameterId String
  qty         Int               @default(1)
  price       Float             @default(0)

  description       String?
  customerSampleId  String?
  samplingLocation  String?
  regulationMatrix  String?
  durationSampling  String?
  method            String?

  quotation   Quotation         @relation(fields: [quotationId], references: [id])
  parameter   AnalysisParameter @relation(fields: [parameterId], references: [id])
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  poNumber    String
  fileUrl     String?
  quotationId String    @unique
  customerId  String

  quotation   Quotation @relation(fields: [quotationId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Ltr {
  id          String    @id @default(cuid())
  ltrNo       String    @unique
  quotationId String    @unique
  createdById String?

  quotation   Quotation @relation(fields: [quotationId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Coc {
  id          String    @id @default(cuid())
  cocNo       String    @unique
  quotationId String    @unique
  sampleId    String?
  createdById String?

  customerEmailCoa String?
  customerCode     String?
  samplerName      String?
  samplingLocation String? @db.Text

  tatRequested TatRequest?
  plannedSamplingStart DateTime?
  plannedSamplingEnd   DateTime?
  estimatedCoaDate     DateTime?

  sampleConditionSamplingInfo   String?
  sampleConditionMethod         String?
  sampleConditionReceived       String?
  abnormalCondition             String?
  specialInstruction            String?
  deliveryMethod                DeliveryMethod?

  quotation   Quotation @relation(fields: [quotationId], references: [id])
  sample      Sample?   @relation(fields: [sampleId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Stps {
  id          String     @id @default(cuid())
  stpsNo      String     @unique
  quotationId String
  cocId       String?
  status      StpsStatus @default(DRAFT)

  technicalManagerName     String?
  technicalManagerPosition String?
  issuedDate               DateTime?

  sampler1Name     String?
  sampler1Position String?
  sampler2Name     String?
  sampler2Position String?
  sampler3Name     String?
  sampler3Position String?
  sampler4Name     String?
  sampler4Position String?

  createdById String?

  quotation   Quotation @relation(fields: [quotationId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Sample {
  id           String            @id @default(cuid())
  sampleNo     String            @unique
  quotationId  String?
  customerId   String
  coaTemplateId String?
  status       SampleStatus      @default(WAITING_SAMPLE)

  sentByCustomerAt DateTime?
  receivedAt       DateTime?
  receivedById     String?

  quotation    Quotation?        @relation(fields: [quotationId], references: [id])
  customer     Customer          @relation(fields: [customerId], references: [id])
  coaTemplate  CoaTemplate?      @relation(fields: [coaTemplateId], references: [id])
  parameters   SampleParameter[]
  coa          Coa[]
  coc          Coc[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model SampleParameter {
  id           String            @id @default(cuid())
  sampleId     String
  parameterId  String
  templateParameterId String?
  analystId    String?
  status       ResultStatus      @default(WAITING)

  resultValue  String?
  resultNote   String?
  retestReason String?

  reviewedById  String?
  verifiedById  String?
  validatedById String?

  sample       Sample            @relation(fields: [sampleId], references: [id])
  parameter    AnalysisParameter @relation(fields: [parameterId], references: [id])
  templateParameter CoaTemplateParameter? @relation(fields: [templateParameterId], references: [id])

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Coa {
  id          String    @id @default(cuid())
  coaNo       String    @unique
  sampleId    String
  type        CoaType
  status      CoaStatus @default(DRAFT)
  fileUrl     String?

  createdById  String?
  approvedById String?

  sample      Sample    @relation(fields: [sampleId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  quotationId String        @unique
  status      InvoiceStatus @default(DRAFT)
  amount      Float         @default(0)

  createdById  String?
  approvedById String?

  quotation   Quotation     @relation(fields: [quotationId], references: [id])
  paymentProofUrl        String?
  paymentProofFileName   String?
  paymentProofUploadedAt DateTime?
  paymentNote            String?   @db.Text
  paidAt                 DateTime?
  paymentConfirmedById   String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model WorkflowLog {
  id        String   @id @default(cuid())
  actorId   String?
  sampleId  String?
  action    String
  note      String?

  createdAt DateTime @default(now())
}