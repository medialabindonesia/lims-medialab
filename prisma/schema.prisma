generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum QuotationStatus {
  REQUESTED
  VERIFIED
  REVISION
  REJECTED
  NEGOTIATION
  APPROVED
  SENT
  CONFIRMED
  PO_UPLOADED
  LTR_CREATED
  COC_CREATED
}

enum QuotationPricingStatus {
  UNPRICED
  PARTIAL
  PRICED
}

enum SampleStatus {
  WAITING_SAMPLE
  SAMPLE_SENT
  RECEIVED
  DISTRIBUTED
  IN_ANALYSIS
  REVIEWED
  VERIFIED
  VALIDATED
  PRELIMINARY_COA
  FINAL_COA
  COMPLETED
  RETEST
}

enum ResultStatus {
  WAITING
  IN_PROGRESS
  ENTERED
  REVIEWED
  VERIFIED
  VALIDATED
  RETEST
}

enum CoaType {
  PRELIMINARY
  FINAL
}

enum CoaStatus {
  DRAFT
  SENT_TO_CUSTOMER
  CUSTOMER_CONFIRMED
  APPROVED
}

enum InvoiceStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  SENT
  PAYMENT_SUBMITTED
  PAID
}

enum SamplingBy {
  MEDIALAB
  CUSTOMER
  THIRD_PARTY
}

/// Saluran tempat customer menyampaikan persetujuannya di luar aplikasi.
enum OfflineConfirmationChannel {
  EMAIL
  WHATSAPP
  PHONE
  MEETING
  SIGNED_DOCUMENT
  OTHER
}

enum TatRequest {
  NORMAL
  URGENT
  TOP_URGENT
}

enum CustomerType {
  DIRECT
  CONSULTANT
}

enum LeadStatus {
  NEW
  QUALIFYING
  SURVEY_REQUIRED
  SURVEY_IN_PROGRESS
  READY_FOR_QUOTATION
  QUOTATION_CREATED
  NOT_SUPPORTED
  LOST
}

enum CapabilityStatus {
  PENDING
  SUPPORTED
  NEEDS_SURVEY
  NOT_SUPPORTED
}

enum SurveyStatus {
  RECOMMENDED
  SCHEDULED
  IN_PROGRESS
  RESUME_READY
  COMPLETED
  CANCELLED
}

enum QuotationEmailStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

/// Biaya komersial di luar paket pengujian laboratorium.
enum QuotationChargeCategory {
  SAMPLING
  DOCUMENT
  OTHER
}

/// Menjaga arti harga quotation lama (per item) dan format resmi baru
/// (satu harga paket per grup) tetap eksplisit saat unitPrice bernilai null.
enum QuotationGroupPricingMode {
  ITEM
  PACKAGE
}

enum TestingObjective {
  ROUTINE_MONITORING
  SUPERVISION
  CASE_PROOF
  RESEARCH
  OTHER
}

enum DeliveryMethod {
  MEDIALAB_SAMPLING
  CUSTOMER_DELIVERY
  COURIER
  OTHER
}

enum StpsStatus {
  DRAFT
  ISSUED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportSenderRole {
  CUSTOMER
  AGENT
  SYSTEM
}

enum SupportContextType {
  GENERAL
  QUOTATION
  ORDER_SAMPLE
  RESULT_REVISION
}

enum SupportAttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum RevisionEntityType {
  QUOTATION
  LAB_RESULT
}

enum RevisionAction {
  CREATED
  UPDATED
  STATUS_TRANSITION
  RESTORED
}

model Role {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  users     User[]
  roleMenus RoleMenu[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id         String  @id @default(cuid())
  name       String
  email      String  @unique
  password   String
  roleId     String
  customerId String?
  isActive   Boolean @default(true)

  role     Role      @relation(fields: [roleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  supportTicketsCreated  SupportTicket[]  @relation("TicketCreatedBy")
  supportTicketsAssigned SupportTicket[]  @relation("TicketAssignedTo")
  supportMessages        SupportMessage[]
  cannedReplies          CannedReply[]
  auditRevisions         AuditRevision[]  @relation("RevisionActor")
  leadsCreated           Lead[]           @relation("LeadCreatedBy")
  leadsAssigned          Lead[]           @relation("LeadAssignedTo")
  surveysRecommended     Survey[]         @relation("SurveyRecommendedBy")
  surveysAssigned        Survey[]         @relation("SurveyAssignedTo")
  quotationEmailsCreated QuotationEmail[] @relation("QuotationEmailCreatedBy")
  quotationEmailsSent    QuotationEmail[] @relation("QuotationEmailSentBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id       String  @id @default(cuid())
  name     String
  key      String  @unique
  href     String
  icon     String?
  parentId String?
  sort     Int     @default(0)
  isActive Boolean @default(true)

  parent    Menu?      @relation("MenuChildren", fields: [parentId], references: [id])
  children  Menu[]     @relation("MenuChildren")
  roleMenus RoleMenu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoleMenu {
  id     String @id @default(cuid())
  roleId String
  menuId String

  canView     Boolean @default(false)
  canCreate   Boolean @default(false)
  canUpdate   Boolean @default(false)
  canDelete   Boolean @default(false)
  canApprove  Boolean @default(false)
  canValidate Boolean @default(false)
  canExport   Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id])
  menu Menu @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
}

/// Perusahaan konsultan yang membawa banyak tenant/client ke Medialab.
/// `code` selalu tiga digit, misalnya 021.
model Consultant {
  id            String  @id @default(cuid())
  code          String  @unique @db.Char(3)
  name          String
  company       String?
  email         String?
  phone         String?
  contactPerson String?
  address       String? @db.Text
  isActive      Boolean @default(true)

  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, name])
}

model Customer {
  id           String       @id @default(cuid())
  customerCode String?      @unique
  customerType CustomerType @default(DIRECT)
  centerCode   String       @default("001") @db.Char(3)
  joinYear     Int?
  sequenceNo   Int?
  consultantId String?
  name         String
  company      String?
  email        String?
  phone        String?
  isActive     Boolean      @default(true)

  contactPerson String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  province      String?
  npwp          String?
  npwpAddress   String?

  billingCompany       String?
  billingAddressLine1  String?
  billingAddressLine2  String?
  billingContactPerson String?
  billingEmail         String?
  billingPhone         String?

  samplingCompany       String?
  samplingAddressLine1  String?
  samplingAddressLine2  String?
  samplingContactPerson String?
  samplingPhone         String?

  documentCompany       String?
  documentAddressLine1  String?
  documentAddressLine2  String?
  documentContactPerson String?
  documentPhone         String?

  recipientEmail1 String?
  recipientEmail2 String?
  recipientEmail3 String?
  recipientEmail4 String?

  consultant     Consultant?     @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  users          User[]
  quotations     Quotation[]
  leads          Lead[]
  samples        Sample[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerType, centerCode, joinYear])
  @@index([consultantId])
}

/// Kontak/kebutuhan awal yang belum menjadi penawaran formal.
model Lead {
  id               String           @id @default(cuid())
  leadNo           String           @unique
  customerId       String
  status           LeadStatus       @default(NEW)
  capabilityStatus CapabilityStatus @default(PENDING)

  requestedTests     String  @db.Text
  customerKnowsScope Boolean @default(false)
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  source             String?
  note               String? @db.Text

  createdById  String?
  assignedToId String?
  quotationId  String? @unique

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  quotation  Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  surveys    Survey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([assignedToId, status])
}

/// Survey teknis yang direkomendasikan CS ketika kebutuhan customer belum
/// cukup jelas untuk langsung dibuatkan quotation.
model Survey {
  id       String       @id @default(cuid())
  surveyNo String       @unique
  leadId   String
  status   SurveyStatus @default(RECOMMENDED)

  scope         String    @db.Text
  location      String?
  scheduledAt   DateTime?
  conductedAt   DateTime?
  resumeSummary String?   @db.Text
  resumeFileUrl String?

  recommendedById String?
  assignedToId    String?

  lead          Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recommendedBy User?             @relation("SurveyRecommendedBy", fields: [recommendedById], references: [id], onDelete: SetNull)
  assignedTo    User?             @relation("SurveyAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  parameters    SurveyParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId, status])
  @@index([assignedToId, status])
}

/// Parameter hasil Resume Survey. Snapshot tetap disimpan agar resume lama
/// tidak berubah ketika master katalog diperbarui.
model SurveyParameter {
  id                    String  @id @default(cuid())
  surveyId              String
  regulationParameterId String?
  parameterName         String
  regulationName        String?
  method                String?
  duration              String?
  samplingLocation      String?
  note                  String? @db.Text
  sort                  Int     @default(0)

  survey              Survey               @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  regulationParameter RegulationParameter? @relation(fields: [regulationParameterId], references: [id], onDelete: SetNull)

  @@index([surveyId, sort])
  @@index([regulationParameterId])
}

model AnalysisParameter {
  id       String  @id @default(cuid())
  name     String
  unit     String?
  method   String?
  price    Float   @default(0)
  isActive Boolean @default(true)

  quotationItems       QuotationItem[]
  sampleParams         SampleParameter[]
  templateParameters   CoaTemplateParameter[]
  regulationParameters RegulationParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoaTemplate {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  parameters CoaTemplateParameter[]
  quotations Quotation[]
  samples    Sample[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoaTemplateParameter {
  id          String @id @default(cuid())
  templateId  String
  parameterId String

  displayName String?
  unit        String?
  method      String?
  standard    String?
  limitValue  String?
  sort        Int     @default(0)
  isRequired  Boolean @default(true)
  isActive    Boolean @default(true)

  template     CoaTemplate       @relation(fields: [templateId], references: [id])
  parameter    AnalysisParameter @relation(fields: [parameterId], references: [id])
  sampleParams SampleParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, parameterId])
}

/// Pohon matriks pengujian dengan kedalaman bebas.
/// Contoh 3 tingkat: Air > Air Limbah > Limbah Industri.
/// Contoh 1 tingkat: Asesmen Ergonomi.
model Matrix {
  id       String  @id @default(cuid())
  parentId String?
  code     String  @unique
  name     String
  note     String?
  sort     Int     @default(0)
  isActive Boolean @default(true)

  parent      Matrix?          @relation("MatrixTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Matrix[]         @relation("MatrixTree")
  regulations Regulation[]
  groups      QuotationGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive, sort])
}

/// Regulasi/baku mutu yang berlaku untuk sebuah matriks.
/// Contoh: PP RI No. 22 Tahun 2021 Lampiran VII (Baku Mutu Udara Ambien).
model Regulation {
  id        String  @id @default(cuid())
  matrixId  String
  code      String  @unique
  /// Beberapa judul regulasi resmi pada master 2024 melebihi 191 karakter.
  name      String  @db.Text
  shortName String?
  note      String? @db.Text
  sort      Int     @default(0)
  isActive  Boolean @default(true)

  matrix     Matrix                     @relation(fields: [matrixId], references: [id], onDelete: Restrict)
  parameters RegulationParameter[]
  groups     QuotationGroup[]
  groupLinks QuotationGroupRegulation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matrixId])
  @@index([isActive, sort])
}

/// Master label durasi sampling. `minutes` hanya untuk pengurutan;
/// GRAB (sesaat) dan Y1 (1 tahun) memakai nilai sentinel.
model SamplingDuration {
  id       String  @id @default(cuid())
  code     String  @unique
  label    String
  minutes  Int?
  sort     Int     @default(0)
  isActive Boolean @default(true)

  regulationParameters RegulationParameterDuration[]
  quotationItems       QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sort])
}

/// Parameter uji sebagaimana berlaku di dalam satu regulasi tertentu.
/// Metode dan baku mutu melekat di sini, bukan di AnalysisParameter,
/// karena parameter yang sama bisa punya metode berbeda antar regulasi.
model RegulationParameter {
  id           String @id @default(cuid())
  regulationId String
  parameterId  String

  displayName    String?
  unit           String?
  method         String?
  limitValue     String?
  limitValue2    String?
  samplingMethod String?
  sampleMatrix   String?
  sampleSize     String?

  /// Harga dasar. Null berarti belum ditetapkan, berbeda dari 0.
  basePrice Float?

  /// Parameter tidak terakreditasi dicetak dengan tanda * pada surat penawaran.
  isAccredited Boolean @default(true)

  /// Ikut tercentang otomatis saat regulasi dipilih di form quotation.
  defaultSelected Boolean @default(true)

  /// Pembeda varian di dalam satu regulasi.
  ///
  /// Satu parameter dapat ditawarkan dengan lebih dari satu metode uji pada
  /// regulasi yang sama — NO2 pada PP 22/2021 tersedia lewat SNI 19-7119.2-2005
  /// maupun MASA 408, dan SO2 punya tiga varian. Tanpa kolom ini varian kedua
  /// dan seterusnya saling menimpa, sehingga 331 layanan yang benar-benar bisa
  /// dikerjakan Medialab tidak pernah muncul di form quotation.
  ///
  /// Nilainya diturunkan dari metode dan satuan lewat
  /// `regulationParameterVariantKey()`. Baris lama memakai string kosong.
  variantKey String @default("") @db.VarChar(64)

  sort     Int     @default(0)
  isActive Boolean @default(true)

  regulation       Regulation                    @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  parameter        AnalysisParameter             @relation(fields: [parameterId], references: [id], onDelete: Restrict)
  durations        RegulationParameterDuration[]
  quotationItems   QuotationItem[]
  surveyParameters SurveyParameter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([regulationId, parameterId, variantKey])
  /// Penopang foreign key `regulationId`. Sebelumnya peran ini dipegang awalan
  /// index unik lama, yang kini sudah memuat kolom `variantKey`.
  @@index([regulationId])
  @@index([parameterId])
}

/// Durasi sampling yang sah untuk sebuah parameter di dalam sebuah regulasi,
/// beserta baku mutu pada durasi tersebut.
/// Contoh: CO punya baris untuk 1 jam dan 8 jam, tetapi tidak untuk 1 tahun.
model RegulationParameterDuration {
  id                    String  @id @default(cuid())
  regulationParameterId String
  durationId            String
  limitValue            String?
  isDefault             Boolean @default(false)
  sort                  Int     @default(0)

  regulationParameter RegulationParameter @relation(fields: [regulationParameterId], references: [id], onDelete: Cascade)
  duration            SamplingDuration    @relation(fields: [durationId], references: [id], onDelete: Restrict)

  @@unique([regulationParameterId, durationId])
  @@index([durationId])
}

model Quotation {
  id          String @id @default(cuid())
  quotationNo String @unique

  /// Kode induk yang diwarisi seluruh dokumen turunan (LTR/CoC/CoA/Invoice).
  /// Contoh: ML-26-0148. Nullable hanya demi data lama; wajib untuk data baru.
  orderCode String? @unique

  customerId    String
  coaTemplateId String?
  status        QuotationStatus @default(REQUESTED)

  /// Gerbang harga. Quotation tidak boleh melewati APPROVED selain saat PRICED.
  pricingStatus QuotationPricingStatus @default(UNPRICED)

  totalAmount            Float   @default(0)
  note                   String?
  revisionReason         String? @db.Text
  rejectionReason        String? @db.Text
  postApprovalEditReason String? @db.Text

  quotationDate DateTime  @default(now())
  validUntil    DateTime?

  samplingBy       SamplingBy?
  testingObjective TestingObjective?
  tatRequested     TatRequest?

  /// Snapshot kebijakan TAT saat quotation dibuat.
  tatBusinessDays    Int   @default(10)
  tatPriceMultiplier Float @default(1)
  tatSurchargeAmount Float @default(0)

  samplingCost   Float   @default(0)
  /// Total biaya DOCUMENT + OTHER. Disimpan sebagai snapshot untuk audit.
  additionalCost Float   @default(0)
  /// Pengurang sebelum PPN; label dibuat eksplisit agar tidak menjadi sel
  /// anonim seperti pada workbook lama.
  discountAmount Float   @default(0)
  discountLabel  String?
  vatPercent     Float   @default(11)
  vatAmount      Float   @default(0)
  grandTotal     Float   @default(0)

  paymentTerm String?
  termsNote   String?

  requestedById String?
  verifiedById  String?
  approvedById  String?

  /// Persetujuan customer atas scope penawaran.
  confirmedAt   DateTime?
  confirmedById String?

  /// true bila ACC diterima di luar sistem (telepon, email, rapat) lalu
  /// dicatatkan oleh sales — bukan customer yang menekan tombol sendiri.
  /// Dipisah agar jejak audit tidak menyamakan keduanya.
  confirmedOffline           Boolean                     @default(false)
  offlineConfirmationChannel OfflineConfirmationChannel?
  offlineConfirmationNote    String?                     @db.Text
  primaryLtrId               String?                     @unique
  primaryCocId               String?                     @unique

  customer       Customer              @relation(fields: [customerId], references: [id])
  coaTemplate    CoaTemplate?          @relation(fields: [coaTemplateId], references: [id])
  items          QuotationItem[]
  groups         QuotationGroup[]
  purchaseOrder  PurchaseOrder?
  ltr            Ltr?                  @relation("PrimaryLtr", fields: [primaryLtrId], references: [id], onDelete: SetNull)
  coc            Coc?                  @relation("PrimaryCoc", fields: [primaryCocId], references: [id], onDelete: SetNull)
  ltrs           Ltr[]                 @relation("QuotationLtrs")
  cocs           Coc[]                 @relation("QuotationCocs")
  invoice        Invoice?
  samples        Sample[]
  stps           Stps[]
  supportTickets SupportTicket[]
  emailDrafts    QuotationEmail[]
  chargeItems    QuotationChargeItem[]
  lead           Lead?

  /// Lease singkat untuk mencegah dua draft/tab mengirim quotation yang sama
  /// secara bersamaan. Dilepas setelah sukses/gagal dan dapat kedaluwarsa.
  emailSendLock     String?
  emailSendLockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emailSendLock, emailSendLockedAt])
}

/// Draft dan riwayat pengiriman email quotation. Isi disimpan sebagai
/// snapshot sehingga sales/manager dapat mengaudit apa yang benar-benar
/// dikirim, bukan hanya melihat template terbaru.
model QuotationEmail {
  id          String               @id @default(cuid())
  quotationId String
  status      QuotationEmailStatus @default(DRAFT)

  toEmail            String
  ccEmails           Json?
  subject            String
  bodyText           String @db.Text
  attachmentManifest Json?

  createdById       String?
  sentById          String?
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?   @db.Text

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("QuotationEmailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentBy    User?     @relation("QuotationEmailSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId, createdAt])
  @@index([status, createdAt])
}

/// Satu baris pada surat penawaran resmi: satu paket pekerjaan.
/// Qty di sini adalah JUMLAH TITIK SAMPLING (mis. Upwind + Downwind = 2),
/// bukan jumlah pengulangan parameter.
model QuotationGroup {
  id          String @id @default(cuid())
  quotationId String
  sort        Int    @default(0)

  /// Label yang dicetak di kolom Deskripsi, mis. "Udara Ambien".
  /// Disimpan sebagai snapshot agar dokumen lama tidak berubah
  /// ketika master matriks di kemudian hari diganti namanya.
  description String?

  matrixId     String?
  regulationId String?

  /// Qty/frekuensi komersial. Tidak diturunkan dari jumlah lokasi sampling.
  qty  Int     @default(1)
  note String?

  /// Harga satu paket/grup sebagaimana tercetak pada surat penawaran resmi.
  /// Null berarti sales belum menetapkan harga paket.
  unitPrice   Float?
  basePrice   Float?
  pricingMode QuotationGroupPricingMode @default(ITEM)

  quotation       Quotation                  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  matrix          Matrix?                    @relation(fields: [matrixId], references: [id], onDelete: SetNull)
  regulation      Regulation?                @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  regulationLinks QuotationGroupRegulation[]
  locations       QuotationGroupLocation[]
  items           QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([matrixId])
  @@index([regulationId])
}

/// Satu paket pengujian dapat mengacu pada lebih dari satu regulasi. Kolom
/// QuotationGroup.regulationId tetap dipertahankan sebagai primary/legacy.
model QuotationGroupRegulation {
  id           String @id @default(cuid())
  groupId      String
  regulationId String
  sort         Int    @default(0)

  group      QuotationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  regulation Regulation     @relation(fields: [regulationId], references: [id], onDelete: Restrict)

  @@unique([groupId, regulationId])
  @@index([regulationId])
}

/// Titik sampling dalam satu grup, mis. "Upwind", "Outlet IPAL". Jumlah titik
/// tidak menentukan qty komersial; qty selalu tersimpan eksplisit pada grup.
model QuotationGroupLocation {
  id      String @id @default(cuid())
  groupId String

  label            String
  customerSampleId String?
  sort             Int     @default(0)

  group QuotationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  groupId     String?
  parameterId String

  /// Asal parameter di master regulasi. Null untuk item yang dibuat
  /// sebelum struktur matriks/regulasi diperkenalkan.
  regulationParameterId String?

  qty  Int @default(1)
  /// Urutan parameter pada dokumen; id menjadi tie-breaker untuk data lama.
  sort Int @default(0)

  /// Null berarti harga BELUM DITETAPKAN. Berbeda maknanya dari 0.
  price Float?

  /// Harga dasar pada saat item dibuat, disimpan sebagai jejak audit
  /// agar terlihat apakah sales menaikkan atau menurunkan harga.
  basePrice Float?

  durationId String?

  description      String?
  customerSampleId String?
  samplingLocation String?
  regulationMatrix String?
  durationSampling String?
  method           String?

  quotation           Quotation            @relation(fields: [quotationId], references: [id])
  group               QuotationGroup?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parameter           AnalysisParameter    @relation(fields: [parameterId], references: [id])
  regulationParameter RegulationParameter? @relation(fields: [regulationParameterId], references: [id], onDelete: SetNull)
  duration            SamplingDuration?    @relation(fields: [durationId], references: [id], onDelete: SetNull)
  ltrItems            LtrItem[]
  cocItems            CocItem[]

  @@index([quotationId])
  @@index([groupId])
  @@index([groupId, sort, id])
  @@index([parameterId])
  @@index([regulationParameterId])
  @@index([durationId])
}

/// Baris biaya sampling, dokumen, atau biaya lain. Pengujian laboratorium
/// tetap memakai QuotationGroup karena membutuhkan parameter dan regulasi.
model QuotationChargeItem {
  id          String                  @id @default(cuid())
  quotationId String
  category    QuotationChargeCategory
  description String
  detail      String?                 @db.Text
  qty         Float                   @default(1)
  unit        String?
  unitPrice   Float?
  sort        Int                     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId, category, sort])
}

model PurchaseOrder {
  id          String  @id @default(cuid())
  poNumber    String
  fileUrl     String?
  quotationId String  @unique
  customerId  String

  quotation Quotation @relation(fields: [quotationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ltr {
  id          String  @id @default(cuid())
  ltrNo       String  @unique
  quotationId String
  sequence    Int     @default(1)
  groupLabel  String?
  createdById String?

  quotation  Quotation  @relation("QuotationLtrs", fields: [quotationId], references: [id])
  primaryFor Quotation? @relation("PrimaryLtr")
  items      LtrItem[]
  cocs       Coc[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, sequence])
  @@index([quotationId])
}

model LtrItem {
  id              String @id @default(cuid())
  ltrId           String
  quotationItemId String
  sort            Int    @default(0)

  ltr           Ltr           @relation(fields: [ltrId], references: [id], onDelete: Cascade)
  quotationItem QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@unique([ltrId, quotationItemId])
  @@index([quotationItemId])
}

model Coc {
  id          String  @id @default(cuid())
  cocNo       String  @unique
  quotationId String
  ltrId       String?
  sampleId    String?
  sequence    Int     @default(1)
  groupLabel  String?
  createdById String?

  customerEmailCoa String?
  customerCode     String?
  samplerName      String?
  samplingLocation String? @db.Text

  tatRequested         TatRequest?
  plannedSamplingStart DateTime?
  plannedSamplingEnd   DateTime?
  estimatedCoaDate     DateTime?

  sampleConditionSamplingInfo String?
  sampleConditionMethod       String?
  sampleConditionReceived     String?
  abnormalCondition           String?
  specialInstruction          String?
  deliveryMethod              DeliveryMethod?

  quotation  Quotation  @relation("QuotationCocs", fields: [quotationId], references: [id])
  primaryFor Quotation? @relation("PrimaryCoc")
  ltr        Ltr?       @relation(fields: [ltrId], references: [id], onDelete: SetNull)
  sample     Sample?    @relation(fields: [sampleId], references: [id])
  items      CocItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, sequence])
  @@index([quotationId])
  @@index([ltrId])
}

model CocItem {
  id              String @id @default(cuid())
  cocId           String
  quotationItemId String
  sort            Int    @default(0)

  coc           Coc           @relation(fields: [cocId], references: [id], onDelete: Cascade)
  quotationItem QuotationItem @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@unique([cocId, quotationItemId])
  @@index([quotationItemId])
}

model Stps {
  id          String     @id @default(cuid())
  stpsNo      String     @unique
  quotationId String
  cocId       String?
  status      StpsStatus @default(DRAFT)

  technicalManagerName     String?
  technicalManagerPosition String?
  issuedDate               DateTime?

  sampler1Name     String?
  sampler1Position String?
  sampler2Name     String?
  sampler2Position String?
  sampler3Name     String?
  sampler3Position String?
  sampler4Name     String?
  sampler4Position String?

  createdById String?

  quotation Quotation @relation(fields: [quotationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sample {
  id            String       @id @default(cuid())
  sampleNo      String       @unique
  quotationId   String?
  customerId    String
  coaTemplateId String?
  status        SampleStatus @default(WAITING_SAMPLE)

  sentByCustomerAt DateTime?
  receivedAt       DateTime?
  receivedById     String?

  quotation      Quotation?        @relation(fields: [quotationId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])
  coaTemplate    CoaTemplate?      @relation(fields: [coaTemplateId], references: [id])
  parameters     SampleParameter[]
  coa            Coa[]
  coc            Coc[]
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SampleParameter {
  id                  String       @id @default(cuid())
  sampleId            String
  parameterId         String
  templateParameterId String?
  analystId           String?
  status              ResultStatus @default(WAITING)

  resultValue  String?
  resultNote   String?
  retestReason String?

  // Snapshot dokumen: perubahan master/template tidak boleh mengubah laporan lama.
  displayNameSnapshot String?
  unitSnapshot        String?
  methodSnapshot      String?
  standardSnapshot    String?
  limitSnapshot       String?

  reviewedById  String?
  verifiedById  String?
  validatedById String?

  sample            Sample                @relation(fields: [sampleId], references: [id])
  parameter         AnalysisParameter     @relation(fields: [parameterId], references: [id])
  templateParameter CoaTemplateParameter? @relation(fields: [templateParameterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coa {
  id       String    @id @default(cuid())
  coaNo    String    @unique
  sampleId String
  type     CoaType
  status   CoaStatus @default(DRAFT)
  fileUrl  String?

  createdById  String?
  approvedById String?

  sample Sample @relation(fields: [sampleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  quotationId String        @unique
  status      InvoiceStatus @default(DRAFT)
  amount      Float         @default(0)

  createdById  String?
  approvedById String?

  quotation              Quotation @relation(fields: [quotationId], references: [id])
  paymentProofUrl        String?
  paymentProofFileName   String?
  paymentProofUploadedAt DateTime?
  paymentNote            String?   @db.Text
  paidAt                 DateTime?
  paymentConfirmedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowLog {
  id       String  @id @default(cuid())
  actorId  String?
  sampleId String?
  action   String
  note     String?

  createdAt DateTime @default(now())
}

model AuditRevision {
  id         String             @id @default(cuid())
  entityType RevisionEntityType
  entityId   String
  revisionNo Int
  action     RevisionAction
  snapshot   Json
  checksum   String             @db.Char(64)

  changeSummary String? @db.Text
  reason        String? @db.Text

  actorId           String?
  actorNameSnapshot String?
  actorRoleSnapshot String?
  requestIp         String?
  userAgent         String? @db.Text
  sourceTicketId    String?

  parentRevisionId       String?
  restoredFromRevisionId String?

  actor          User?           @relation("RevisionActor", fields: [actorId], references: [id])
  parent         AuditRevision?  @relation("RevisionParent", fields: [parentRevisionId], references: [id])
  childRevisions AuditRevision[] @relation("RevisionParent")
  restoredFrom   AuditRevision?  @relation("RevisionRestore", fields: [restoredFromRevisionId], references: [id])
  restoreEvents  AuditRevision[] @relation("RevisionRestore")
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())

  @@unique([entityType, entityId, revisionNo])
  @@index([entityType, entityId, createdAt])
  @@index([checksum])
  @@index([actorId])
}

model FaqCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  sort        Int     @default(0)
  isActive    Boolean @default(true)

  items   FaqItem[]
  tickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id         String  @id @default(cuid())
  categoryId String
  question   String  @db.Text
  answer     String  @db.Text
  sort       Int     @default(0)
  isActive   Boolean @default(true)

  helpfulCount    Int @default(0)
  notHelpfulCount Int @default(0)

  category FaqCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model SupportTicket {
  id           String              @id @default(cuid())
  ticketNo     String              @unique
  customerId   String
  categoryId   String?
  createdById  String
  subject      String
  status       SupportTicketStatus @default(OPEN)
  priority     SupportPriority     @default(NORMAL)
  contextType  SupportContextType  @default(GENERAL)
  contextLabel String?
  quotationId  String?
  sampleId     String?
  revisionId   String?

  assignedToId    String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastMessageAt   DateTime?

  rating        Int?
  ratingComment String? @db.Text

  customer   Customer         @relation(fields: [customerId], references: [id])
  category   FaqCategory?     @relation(fields: [categoryId], references: [id])
  createdBy  User             @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedTo User?            @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  quotation  Quotation?       @relation(fields: [quotationId], references: [id])
  sample     Sample?          @relation(fields: [sampleId], references: [id])
  revision   AuditRevision?   @relation(fields: [revisionId], references: [id])
  messages   SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([contextType])
  @@index([quotationId])
  @@index([sampleId])
  @@index([revisionId])
  @@index([lastMessageAt])
  @@index([createdAt])
}

model SupportMessage {
  id             String            @id @default(cuid())
  ticketId       String
  senderId       String?
  senderRole     SupportSenderRole
  body           String            @db.Text
  isInternalNote Boolean           @default(false)

  readByCustomerAt DateTime?
  readByAgentAt    DateTime?

  ticket      SupportTicket       @relation(fields: [ticketId], references: [id])
  sender      User?               @relation(fields: [senderId], references: [id])
  attachments SupportAttachment[]

  createdAt DateTime @default(now())

  @@index([ticketId])
}

model SupportAttachment {
  id          String                @id @default(cuid())
  messageId   String
  kind        SupportAttachmentKind
  fileName    String
  mimeType    String
  sizeBytes   Int
  url         String                @db.Text
  downloadUrl String?               @db.Text

  width             Int?
  height            Int?
  durationSeconds   Float?
  originalSizeBytes Int?
  isCompressed      Boolean @default(false)
  checksum          String? @db.Char(64)

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([kind])
}

model CannedReply {
  id       String  @id @default(cuid())
  title    String
  body     String  @db.Text
  sort     Int     @default(0)
  isActive Boolean @default(true)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
